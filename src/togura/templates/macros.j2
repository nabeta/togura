{# 共通で使用するマクロ #}

{# サイト名とロゴのリンク。rootはトップページへの相対パス #}
{% macro site_header(site_name, root=".") %}
  <p>
    <a href="{{ root }}/index.html"><img src="{{ root }}/images/logo.png" height="48"></a>
    <a href="{{ root }}/index.html">{{ site_name }}</a>
  </p>
{% endmacro %}

{# 一覧ページの資料一覧 #}
{% macro entry_list(entries) %}
  <ul>
    {% for entry in entries %}
      <li>
        <a href="{{ entry.id }}/ro-crate-preview.html">
          {{ entry.id }}
          [{{ entry.type }}]
          {% for creator in entry.creator %}
            {% if creator.creator_name|length > 0 %}
              {{ creator.creator_name[0].name }}
            {% endif %}
          {% endfor %}.
          {{ entry.title[0].title }}
        </a>

        {% for file in entry.file %}
          {% for date in file.date %}
            {{ date.date_type }}:
            {{ date.date }}
          {% endfor %}
        {% endfor %}
      </li>
    {% endfor %}
  </ul>
{% endmacro %}

{# JPCOARスキーマの項目へのリンク付きの見出し #}
{% macro field_label(label, schema_id) %}
  <dt class="col-sm-2"><a href="https://schema.irdb.nii.ac.jp/ja/schema/2.0/{{ schema_id }}">{{ label }}</a></dt>
{% endmacro %}

{# 詳細画面の1項目分の枠。中身は呼び出し側の{% call %}ブロックで指定する #}
{% macro field(label, schema_id) %}
  <dl class="row border rounded p-3">
    {{ field_label(label, schema_id) }}
    <dd class="col-sm-10">{{ caller() }}</dd>
  </dl>
{% endmacro %}

{# 項目の値の一覧を、itemsの各要素のkeyを見出し、valueを値として表示する #}
{% macro pairs(items, key, value) %}
  <dl class="row border rounded">
    {% for item in items %}
      <dt class="col-sm-2">{{ item[key] }}</dt>
      <dd class="col-sm-10">{{ item[value] }}</dd>
    {% endfor %}
  </dl>
{% endmacro %}

{# 項目の値の一覧を、itemsの各要素のkeyを見出し、valueを値とした枠付きで表示する #}
{% macro pairs_field(label, schema_id, items, key, value) %}
  {% call field(label, schema_id) %}{{ pairs(items, key, value) }}{% endcall %}
{% endmacro %}

{# 作成者・寄与者 #}
{% macro agents(label, schema_id, items, name_key, affiliation_label) %}
  <dl class="row border rounded p-3">
    {% for agent in items %}
      {{ field_label(label, schema_id) }}
      <dd class="col-sm-10">
        <dl class="row border rounded">
          {% for name in agent[name_key] %}
            <dt class="col-sm-2">{{ name.lang }}</dt>
            <dd class="col-sm-10">{{ name.name }}</dd>
          {% endfor %}
          {% for name_identifier in agent.name_identifier %}
            <dt class="col-sm-2">{{ name_identifier.identifier_scheme }}</dt>
            {% if name_identifier.identifier_scheme == "ORCID" %}
              <dd class="col-sm-10"><a href="{{ name_identifier.identifier }}" rel="nofollow">{{ name_identifier.identifier }}</a></dd>
            {% else %}
              <dd class="col-sm-10">{{ name_identifier.identifier }}</dd>
            {% endif %}
          {% endfor %}
          {% if agent.affiliation %}
            <dt class="col-sm-2">{{ affiliation_label }}</dt>
            <dd class="col-sm-10">
              <dl class="row">
                {% for affiliation in agent.affiliation %}
                  {% for name_identifier in affiliation.name_identifier %}
                    <dt class="col-sm-2">{{ name_identifier.identifier_scheme }}</dt>
                    <dd class="col-sm-10">{{ name_identifier.identifier }}</dd>
                  {% endfor %}
                  {% for affiliation_name in affiliation.affiliation_name %}
                    <dt class="col-sm-2">{{ affiliation_name.lang }}</dt>
                    <dd class="col-sm-10">{{ affiliation_name.name }}</dd>
                  {% endfor %}
                {% endfor %}
              </dl>
            </dd>
          {% endif %}
        </dl>
      </dd>
    {% endfor %}
  </dl>
{% endmacro %}

{# 最終更新日と機械可読なデータへのリンク #}
{% macro last_updated(now) %}
  <div>
    最終更新日: {{ now }}
    {{ caller() }}
  </div>
{% endmacro %}

{% extends "base.j2" %}
{% import "macros.j2" as m %}

{% block content %}
  <h1>
    <a href="index.html"><img src="images/logo.png" height="72"></a>
    {{ site_name }}
  </h1>

  <h2>収録資料の一覧</h2>

  <div class="pb-3">
    {% for page in range(1, total_pages + 1) %}
      <a href="index{{ page }}.html">index{{ page }}.html</a>
    {% endfor %}
  </div>

  <h2>最近の登録</h2>

  {{ m.entry_list(entries) }}

  {% call m.last_updated(now) %}
    <a href="resourcelist.xml">ResourceSync XML</a>
  {% endcall %}
{% endblock %}

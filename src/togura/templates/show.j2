{% extends "base.j2" %}
{% import "macros.j2" as m %}

{% block title %}{{ entry.title[0].title }} | {{ site_name }}{% endblock %}

{% block content %}
  {{ m.site_header(site_name, "..") }}

  <h1>{{ entry.title[0].title }}</h1>

  <p>
    {{ base_url }}/{{ entry.id }}/ro-crate-preview.html
  </p>

  {% call m.field("ファイル情報", 43) %}
    <dl class="row border rounded">
      {% for file in entry.file or [] %}
        <dt class="col-sm-2">ファイル形式</dt>
        <dd class="col-sm-10">{{ file.mime_type }}</dd>
        <dt class="col-sm-2">URI</dt>
        <dd class="col-sm-10"><a href="{{ file.uri }}">{{ file.uri }}</a></dd>
        {% if file.extent %}
          <dt class="col-sm-2">大きさ</dt>
          <dd class="col-sm-10">{{ file.extent|join(" ") }}</dd>
        {% endif %}
        {% for date in file.date %}
          <dt class="col-sm-2">{{ date.date_type }}</dt>
          <dd class="col-sm-10">{{ date.date }}</dd>
        {% endfor %}
        {% if file.version %}
          <dt class="col-sm-2">バージョン</dt>
          <dd class="col-sm-10">{{ file.version }}</dd>
        {% endif %}
      {% endfor %}
      {% for file in files %}
        <dt class="col-sm-2">URI</dt>
        <dd class="col-sm-10"><a href="./{{ file }}">{{ base_url }}/{{ entry.id }}/{{ file }}</a></dd>
      {% endfor %}
    </dl>
  {% endcall %}

  {% call m.field("資源タイプ", 15) %}{{ entry.type }}{% endcall %}

  {% if entry.version %}
    {% call m.field("バージョン情報", 16) %}{{ entry.version }}{% endcall %}
  {% endif %}

  {% if entry.text_version %}
    {% call m.field("出版タイプ", 17) %}{{ entry.text_version }}{% endcall %}
  {% endif %}

  {{ m.pairs_field("タイトル", 1, entry.title, "lang", "title") }}

  {% if entry.alternative %}
    {{ m.pairs_field("その他のタイトル", 2, entry.alternative, "lang", "title") }}
  {% endif %}

  {% if entry.creator %}
    {{ m.agents("作成者", 3, entry.creator, "creator_name", "作成者所属") }}
  {% endif %}

  {% if entry.contributor %}
    {{ m.agents("寄与者", 4, entry.contributor, "contributor_name", "寄与者所属") }}
  {% endif %}

  {% if entry.access_rights %}
    {% call m.field("アクセス権", 5) %}{{ entry.access_rights }}{% endcall %}
  {% endif %}

  {% if entry.rights %}
    {% call m.field("権利情報", 6) %}
      <dl class="row border rounded">
        {% for right in entry.rights %}
          <dt class="col-sm-2">{{ right.lang }}</dt>
          <dd class="col-sm-10">{{ right.rights }}</dd>
          <dt class="col-sm-2">URI</dt>
          <dd class="col-sm-10">{{ right.rights_uri }}</dd>
        {% endfor %}
      </dl>
    {% endcall %}
  {% endif %}

  {% if entry.rights_holder %}
    {{ m.agents("権利者情報", 7, entry.rights_holder, "rights_holder_name", "") }}
  {% endif %}

  {% if entry.subject %}
    {{ m.pairs_field("主題", 8, entry.subject, "subject_scheme", "subject") }}
  {% endif %}

  {% if entry.description %}
    {{ m.pairs_field("内容記述", 9, entry.description, "description_type", "description") }}
  {% endif %}

  {% if entry.publisher %}
    {{ m.pairs_field("出版者", 10, entry.publisher, "lang", "publisher") }}
  {% endif %}

  {% if entry.jpcoar_publisher %}
    {% call m.field("出版者情報", 11) %}
      {% for publisher in entry.jpcoar_publisher %}
        <dl class="row border rounded">
          {% for name in publisher.publisher_name or [] %}
            <dt class="col-sm-2">{{ name.lang }}</dt>
            <dd class="col-sm-10">{{ name.publisher_name }}</dd>
          {% endfor %}
          {% for description in publisher.publisher_description or [] %}
            <dt class="col-sm-2">出版者注記</dt>
            <dd class="col-sm-10">{{ description.publisher_description }}</dd>
          {% endfor %}
          {% for location in publisher.location or [] %}
            <dt class="col-sm-2">出版地</dt>
            <dd class="col-sm-10">{{ location.location }}</dd>
          {% endfor %}
          {% for place in publisher.publication_place or [] %}
            <dt class="col-sm-2">出版地（国名コード）</dt>
            <dd class="col-sm-10">{{ place.publication_place }}</dd>
          {% endfor %}
        </dl>
      {% endfor %}
    {% endcall %}
  {% endif %}

  {% if entry.date %}
    {{ m.pairs_field("日付", 12, entry.date, "date_type", "date") }}
  {% endif %}

  {% if entry.dcterms_date %}
    {{ m.pairs_field("日付（リテラル）", 13, entry.dcterms_date, "lang", "date") }}
  {% endif %}

  {% if entry.language %}
    {% call m.field("言語", 14) %}{{ entry.language|join(" ") }}{% endcall %}
  {% endif %}

  {% call m.field("識別子", 18) %}
    <ul>
      {% for identifier in entry.identifier %}
        <li><a href="{{ identifier }}" rel="nofollow">{{ identifier }}</a></li>
      {% endfor %}
    </ul>
  {% endcall %}

  {% if entry.identifier_registration %}
    {% set doi_url = "https://doi.org/" ~ entry.identifier_registration.identifier %}
    {% call m.field("ID登録", 19) %}<a href="{{ doi_url }}" rel="nofollow">{{ doi_url }}</a>{% endcall %}
  {% endif %}

  {% if entry.relation %}
    {% call m.field("関連情報", 20) %}
      <dl class="row border rounded">
        {% for relation in entry.relation %}
          {% set related_identifier = relation.related_identifier.identifier %}
          <dt class="col-sm-2">{{ relation.relation_type }}</dt>
          <dd class="col-sm-10"><a href="{{ related_identifier }}" rel="nofollow">{{ related_identifier }}</a></dd>
        {% endfor %}
      </dl>
    {% endcall %}
  {% endif %}

  {% if entry.temporal %}
    {{ m.pairs_field("時間的範囲", 21, entry.temporal, "lang", "temporal") }}
  {% endif %}

  {% if entry.geo_location %}
    {% call m.field("位置情報", 22) %}
      {% for geo_location in entry.geo_location %}
        {% set point = geo_location.geo_location_point %}
        {% set box = geo_location.geo_location_box %}
        <dl class="row border rounded">
          {% if point %}
            <dt class="col-sm-2">位置情報（点）</dt>
            <dd class="col-sm-10">経度 {{ point.point_longitude }}、緯度 {{ point.point_latitude }}</dd>
          {% endif %}
          {% if box %}
            <dt class="col-sm-2">位置情報（空間）</dt>
            <dd class="col-sm-10">
              西端経度 {{ box.west_bound_longitude }}、東端経度 {{ box.east_bound_longitude }}、
              南端緯度 {{ box.south_bound_latitude }}、北端緯度 {{ box.north_bound_latitude }}
            </dd>
          {% endif %}
          {% for place in geo_location.geo_location_place or [] %}
            <dt class="col-sm-2">位置情報（自由記述）</dt>
            <dd class="col-sm-10">{{ place }}</dd>
          {% endfor %}
        </dl>
      {% endfor %}
    {% endcall %}
  {% endif %}

  {% if entry.funding_reference %}
    {% call m.field("助成情報", 23) %}
      <dl class="row border rounded">
        {% for funding_reference in entry.funding_reference %}
          {% set award_number = funding_reference.award_number %}
          {% set funder_identifier = funding_reference.funder_identifier %}
          <dt class="col-sm-2">
            {{ award_number.award_number_type }}
            {% if award_number.award_number_type == "JGN" %}
              <a href="{{ award_number.award_uri }}" rel="nofollow">{{ award_number.award_number }}</a>
            {% else %}
              {{ award_number.award_number }}
            {% endif %}
          </dt>
          <dd class="col-sm-10">
            <dl class="row">
              {% if funder_identifier %}
                <dt class="col-sm-2">{{ funder_identifier.funder_identifier_type }}</dt>
                <dd class="col-sm-10">{{ funder_identifier.funder_identifier }}</dd>
              {% endif %}
              {% for funder_name in funding_reference.funder_name %}
                <dt class="col-sm-2">{{ funder_name.lang }}</dt>
                <dd class="col-sm-10">{{ funder_name.funder_name }}</dd>
              {% endfor %}
              {% for funding_stream in funding_reference.funding_stream %}
                <dt class="col-sm-2">{{ funding_stream.lang }}</dt>
                <dd class="col-sm-10">{{ funding_stream.funding_stream }}</dd>
              {% endfor %}
              {% for award_title in funding_reference.award_title %}
                <dt class="col-sm-2">{{ award_title.lang }}</dt>
                <dd class="col-sm-10">{{ award_title.award_title }}</dd>
              {% endfor %}
            </dl>
          </dd>
        {% endfor %}
      </dl>
    {% endcall %}
  {% endif %}

  {% if entry.source_identifier %}
    {{ m.pairs_field("収録物識別子", 24, entry.source_identifier, "identifier_type", "identifier") }}
  {% endif %}

  {% if entry.source_title %}
    {% call m.field("収録物名", 25) %}
      <dl class="row border rounded">
        {% for source_title in entry.source_title %}
          <dt class="col-sm-2">{{ source_title.lang }}</dt>
          <dd class="col-sm-10">
            {{ source_title.source_title }}.
            {% if entry.volume %}
              vol. {{ entry.volume }},
            {% endif %}
            {% if entry.issue %}
              issue {{ entry.issue }}.
            {% endif %}
            {{ entry.page_start }}-{{ entry.page_end }}.
          </dd>
        {% endfor %}
      </dl>
    {% endcall %}
  {% endif %}

  {% if entry.num_pages %}
    {% call m.field("ページ数", 28) %}{{ entry.num_pages }}{% endcall %}
  {% endif %}

  {% if entry.dissertation_number %}
    <dl class="row border rounded p-3">
      {{ m.field_label("学位授与番号", 31) }}
      <dd class="col-sm-10">{{ entry.dissertation_number }}</dd>
      {{ m.field_label("学位名", 32) }}
      <dd class="col-sm-10">{{ m.pairs(entry.degree_name, "lang", "degree_name") }}</dd>
      {{ m.field_label("学位授与年月日", 33) }}
      <dd class="col-sm-10">{{ entry.date_granted }}</dd>
      {{ m.field_label("学位授与機関", 34) }}
      <dd class="col-sm-10">
        {% for degree_grantor in entry.degree_grantor %}
          {{ m.pairs(degree_grantor.degree_grantor_name, "lang", "name") }}
        {% endfor %}
      </dd>
    </dl>
  {% endif %}

  {% if entry.conference %}
    {% call m.field("会議記述", 35) %}
      {% for conference in entry.conference %}
        {% set conference_date = conference.conference_date %}
        <dl class="row border rounded">
          {% for name in conference.conference_name or [] %}
            <dt class="col-sm-2">{{ name.lang }}</dt>
            <dd class="col-sm-10">{{ name.conference_name }}</dd>
          {% endfor %}
          {% if conference.conference_sequence %}
            <dt class="col-sm-2">回次</dt>
            <dd class="col-sm-10">{{ conference.conference_sequence }}</dd>
          {% endif %}
          {% for sponsor in conference.conference_sponsor or [] %}
            <dt class="col-sm-2">主催機関</dt>
            <dd class="col-sm-10">{{ sponsor.conference_sponsor }}</dd>
          {% endfor %}
          {% if conference_date %}
            {% set start = [conference_date.start_year, conference_date.start_month, conference_date.start_day]|select|join("-") %}
            {% set end = [conference_date.end_year, conference_date.end_month, conference_date.end_day]|select|join("-") %}
            <dt class="col-sm-2">開催期間</dt>
            <dd class="col-sm-10">
              {{ conference_date.conference_date }}
              {% if start or end %}({{ start }} - {{ end }}){% endif %}
            </dd>
          {% endif %}
          {% for venue in conference.conference_venue or [] %}
            <dt class="col-sm-2">開催会場</dt>
            <dd class="col-sm-10">{{ venue.conference_venue }}</dd>
          {% endfor %}
          {% for place in conference.conference_place or [] %}
            <dt class="col-sm-2">開催地</dt>
            <dd class="col-sm-10">{{ place.conference_place }}</dd>
          {% endfor %}
          {% if conference.conference_country %}
            <dt class="col-sm-2">開催国</dt>
            <dd class="col-sm-10">{{ conference.conference_country.conference_country }}</dd>
          {% endif %}
        </dl>
      {% endfor %}
    {% endcall %}
  {% endif %}

  {% if entry.edition %}
    {{ m.pairs_field("版", 36, entry.edition, "lang", "edition") }}
  {% endif %}

  {% if entry.volume_title %}
    {{ m.pairs_field("部編名", 37, entry.volume_title, "lang", "volume_title") }}
  {% endif %}

  {% if entry.original_language %}
    {% call m.field("原文の言語", 38) %}{{ entry.original_language|join(" ") }}{% endcall %}
  {% endif %}

  {% if entry.extent %}
    {{ m.pairs_field("大きさ", 39, entry.extent, "lang", "extent") }}
  {% endif %}

  {% if entry.format %}
    {{ m.pairs_field("物理的形態", 40, entry.format, "lang", "format") }}
  {% endif %}

  {% if entry.holding_agent %}
    {% set holding_agent_identifier = entry.holding_agent.holding_agent_name_identifier %}
    {% call m.field("所蔵機関", 41) %}
      <dl class="row border rounded">
        {% if holding_agent_identifier and holding_agent_identifier.identifier %}
          <dt class="col-sm-2">{{ holding_agent_identifier.name_identifier_scheme }}</dt>
          <dd class="col-sm-10"><a href="{{ holding_agent_identifier.identifier }}" rel="nofollow">{{ holding_agent_identifier.identifier }}</a></dd>
        {% endif %}
        {% for name in entry.holding_agent.holding_agent_name or [] %}
          <dt class="col-sm-2">{{ name.lang }}</dt>
          <dd class="col-sm-10">{{ name.holding_agent_name }}</dd>
        {% endfor %}
      </dl>
    {% endcall %}
  {% endif %}

  {% if entry.dataset_series is defined and entry.dataset_series is not none %}
    {% call m.field("データセットシリーズ", 42) %}{{ entry.dataset_series }}{% endcall %}
  {% endif %}

  {% if entry.catalog %}
    {% set catalog = entry.catalog %}
    {% call m.field("カタログ", 44) %}
      <dl class="row border rounded">
        {% for contributor in catalog.contributor or [] %}
          <dt class="col-sm-2">提供機関</dt>
          <dd class="col-sm-10">{{ m.pairs(contributor.contributor_name or [], "lang", "name") }}</dd>
        {% endfor %}
        {% if catalog.identifier %}
          <dt class="col-sm-2">識別子</dt>
          <dd class="col-sm-10">
            <ul>
              {% for identifier in catalog.identifier %}
                <li><a href="{{ identifier }}" rel="nofollow">{{ identifier }}</a></li>
              {% endfor %}
            </ul>
          </dd>
        {% endif %}
        {% if catalog.title %}
          <dt class="col-sm-2">タイトル</dt>
          <dd class="col-sm-10">{{ m.pairs(catalog.title, "lang", "title") }}</dd>
        {% endif %}
        {% if catalog.description %}
          <dt class="col-sm-2">内容記述</dt>
          <dd class="col-sm-10">{{ m.pairs(catalog.description, "description_type", "description") }}</dd>
        {% endif %}
        {% if catalog.subject %}
          <dt class="col-sm-2">主題</dt>
          <dd class="col-sm-10">{{ m.pairs(catalog.subject, "subject_scheme", "subject") }}</dd>
        {% endif %}
        {% for license in catalog.license or [] %}
          <dt class="col-sm-2">ライセンス</dt>
          <dd class="col-sm-10">
            {% if license.license_uri %}
              <a href="{{ license.license_uri }}" rel="nofollow">{{ license.license }}</a>
            {% else %}
              {{ license.license }}
            {% endif %}
          </dd>
        {% endfor %}
        {% for right in catalog.rights or [] %}
          <dt class="col-sm-2">権利情報</dt>
          <dd class="col-sm-10">
            {% if right.rights_uri %}
              <a href="{{ right.rights_uri }}" rel="nofollow">{{ right.rights }}</a>
            {% else %}
              {{ right.rights }}
            {% endif %}
          </dd>
        {% endfor %}
        {% if catalog.access_rights %}
          <dt class="col-sm-2">アクセス権</dt>
          <dd class="col-sm-10">{{ catalog.access_rights }}</dd>
        {% endif %}
        {% if catalog.file and catalog.file.uri %}
          <dt class="col-sm-2">代表画像</dt>
          <dd class="col-sm-10"><a href="{{ catalog.file.uri }}" rel="nofollow">{{ catalog.file.uri }}</a></dd>
        {% endif %}
      </dl>
    {% endcall %}
  {% endif %}

  <div>
    <a href="../index.html">トップページ</a>
  </div>

  {% call m.last_updated(now) %}
    <a href="jpcoar20.xml" rel="nofollow">JPCOAR Schema 2.0 XML</a>
    <a href="ro-crate-metadata.json" rel="nofollow">RO-Crate JSON</a>
    {% if entry.identifier_registration %}
      <a href="jalc.xml" rel="nofollow">JaLC XML</a>
    {% endif %}
  {% endcall %}
{% endblock %}

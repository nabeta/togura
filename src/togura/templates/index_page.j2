{% extends "base.j2" %}
{% import "macros.j2" as m %}

{% block content %}
  {{ m.site_header(site_name) }}

  <h2>収録資料の一覧</h2>

  <p>{{ (page - 1) * per_page + 1 }}件目から{{ page * per_page }}件目までの登録を表示しています。</p>

  {{ m.entry_list(entries) }}

  <div>
    <a href="index.html">トップページ</a>

    {% if previous_page %}
      <a href="index{{ previous_page }}.html">前のページ</a>
    {% endif %}

    {% if next_page %}
      <a href="index{{ next_page }}.html">次のページ</a>
    {% endif %}
  </div>

  {% call m.last_updated(now) %}
    <a href="resourcelist.xml">ResourceSync XML</a>
  {% endcall %}
{% endblock %}
